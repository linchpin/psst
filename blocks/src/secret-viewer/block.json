{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "psst/secret-viewer",
	"version": "1.0.5",
	"title": "Secret Viewer",
	"category": "widgets",
	"icon": "visibility",
	"description": "Shows a shared secret. Place it on the page secret links point at; the recipient clicks to reveal, decrypts in the browser, and the secret is destroyed.",
	"keywords": [ "psst", "secret", "reveal" ],
	"attributes": {
		"heading": {
			"type": "string",
			"default": "Your Shared Secret"
		},
		"intro": {
			"type": "string",
			"default": "Once you click view, your secret will be revealed. Once viewed it will be removed."
		}
	},
	"supports": {
		"html": false,
		"interactivity": true,
		"multiple": false,
		"renaming": false,
		"reusable": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"background": true,
			"text": true
		}
	},
	"example": {
		"attributes": {}
	},
	"textdomain": "psst",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./edit.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js"
}
