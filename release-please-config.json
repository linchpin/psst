{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"release-type": "php",
	"packages": {
		".": {
			"name": "psst",
			"extra-files": [
				"psst.php",
				"README.md",
				".release-please-manifest.json",
				{
					"type": "json",
					"path": "package.json",
					"jsonpath": "$.version"
				},
				{
					"type": "json",
					"path": "blocks/package.json",
					"jsonpath": "$.version"
				}
			]
		}
	},
	"pull-request-header": ":gem: Automated Release",
	"include-component-in-tag": false,
	"include-v-in-tag": true,
	"changelog-sections": [
		{ "type": "feat", "section": "Features ✨" },
		{ "type": "feature", "section": "Features ✨" },
		{ "type": "fix", "section": "Bug Fixes 🐛" },
		{ "type": "style", "section": "Styles 💄" },
		{ "type": "test", "section": "Tests 🧪" },
		{ "type": "perf", "section": "Performance Improvements ⚡️" },
		{ "type": "chore", "section": "Miscellaneous Chores 🧹" },
		{ "type": "tweak", "section": "Changes to Existing Features 💅" },
		{ "type": "refactor", "section": "Changes to Existing Features 💅" },
		{ "type": "improve", "section": "Changes to Existing Features 💅" },
		{ "type": "update", "section": "Changes to Existing Features 💅" },
		{ "type": "revert", "section": "Reverts ⏪️" },
		{ "type": "docs", "section": "Documentation", "hidden": true },
		{ "type": "build", "section": "Build System", "hidden": true },
		{ "type": "ci", "section": "Continuous Integration", "hidden": true }
	]
}
