{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/share/",
	"steps": [
		{
			"step": "setSiteOptions",
			"options": {
				"permalink_structure": "/%postname%/",
				"blogname": "Psst"
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "/wordpress/wp-content/plugins/psst/psst.php"
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; require '/wordpress/wp-content/plugins/psst/tests/e2e/seed.php';"
		}
	]
}
