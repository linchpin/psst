{
  "name": "@linchpin/psst",
  "version": "2.0.0",
  "description": "Pretty Secure Secret Transmissions. Share one-time, expiring secrets that are encrypted in the browser.",
  "author": "Linchpin <sayhi@linchpin.com>",
  "license": "GPL-2.0-or-later",
  "private": true,
  "main": "src/admin/index.js",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "format": "wp-scripts format",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style",
    "packages-update": "wp-scripts packages-update",
    "prepare": "husky",
    "install:all": "npm install && npm install --prefix blocks",
    "install:ci": "npm ci && npm ci --prefix blocks",
    "build:blocks": "npm run build --prefix blocks",
    "build:all": "npm run build && npm run build:blocks",
    "start:blocks": "npm run start --prefix blocks",
    "test:unit": "npm run test:unit --prefix blocks",
    "playground:start": "wp-playground-cli server --php=8.3 --wp=6.9 --port=9400 --site-url=http://localhost:9400 --blueprint=./playground/blueprint.json --mount=.:/wordpress/wp-content/plugins/psst",
    "test:e2e": "npx playwright test --config=tests/e2e/playwright.config.mjs",
    "playwright:install": "npx playwright install --with-deps chromium"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@linchpinagency/commitlint-config": "^1.3.1",
    "@playwright/test": "^1.63.0",
    "@wordpress/api-fetch": "^7.55.0",
    "@wordpress/components": "^40.1.0",
    "@wordpress/core-data": "^8.0.0",
    "@wordpress/data": "^10.55.0",
    "@wordpress/dataviews": "^19.0.0",
    "@wordpress/date": "^5.55.0",
    "@wordpress/dependency-extraction-webpack-plugin": "^6.55.0",
    "@wordpress/dom-ready": "^4.55.0",
    "@wordpress/element": "^8.7.0",
    "@wordpress/hooks": "^4.55.0",
    "@wordpress/i18n": "^6.28.0",
    "@wordpress/icons": "^16.0.0",
    "@wordpress/notices": "^5.55.0",
    "@wordpress/scripts": "^35.0.0",
    "@wp-playground/cli": "^3.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "webpack-remove-empty-scripts": "^1.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linchpin/psst.git"
  },
  "bugs": {
    "url": "https://github.com/linchpin/psst/issues"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "browserslist": [
    "defaults"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npx wp-scripts format"
    ],
    "*.{css,scss}": [
      "npx wp-scripts lint-style --fix"
    ],
    "*.php": [
      "./scripts/phpcbf-staged.sh",
      "./scripts/phpcs-staged.sh"
    ]
  }
}
